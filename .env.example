# ---------------------------------------------------------------
# Google Sheets — Apps Script web app (see google-apps-script/Code.gs)
# The /exec URL from Deploy > New deployment > Web app
GOOGLE_SHEETS_WEBHOOK_URL=https://script.google.com/macros/s/AKfycbyvqVCnnAIIcK5S0246sG-MqLij4m0hIqXHf3qdjJwQ13cXizUihBMZMFy8GZLIQUM/exec
# Optional but recommended: must match the WEBHOOK_SECRET Script Property
GOOGLE_SHEETS_SECRET=

# ---------------------------------------------------------------
# TeleCRM — lead API
# e.g. https://next-api.telecrm.in/v2/enterprise/<ENTERPRISE_ID>/autoupdatelead
TELECRM_API_URL=https://next-api.telecrm.in/v2/enterprise/6b08f013e49bcc6af80ee2c1/autoupdatelead
TELECRM_API_KEY=0fee353c-862c-4480-b2e0-cb89ac3ba49c1795759372186:457dcbd5-b82f-436e-8f0c-1de808b0f20d

# ---------------------------------------------------------------
# GMB review funnel (/review): where 4-5 star ratings go.
# Google Business Profile > "Ask for reviews" > copy link (https://g.page/r/XXXX/review)
# If empty, the link in lib/site.ts (reviewFunnel.googleReviewUrl) is used.
NEXT_PUBLIC_GOOGLE_REVIEW_URL=

# ---------------------------------------------------------------
# Optional tracking
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_META_PIXEL_ID=

